{
  "task_description": "{'component_name': 'Main Container for LearnPath AI', 'description': 'Primary container for LearnPath AI implementation: An AI-powered app that generates personalized learning roadmaps for any tech or academic goal. Users input a goal, and the app analyzes it to create a step-by-step path with curated resources, progress tracking, and smart suggestions. use necessary APIs for providing the related resource links(YouTube Data API,Udemy, Coursera APIs, edX ,GitHub Search API , FreeCodeCamp API ,W3Schools Content API,GeeksforGeeks API,Dev.to API,Medium API,Medium API,Open API Aggregators, Firebase for user progress tracking)', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Goal Analysis",\n      "description": "Automatically breaks down user-entered learning goals into subtopics, prerequisites, and a logical skill progression.",\n      "isEnabled": true\n    },\n    {\n      "name": "Path Generator",\n      "description": "Curates a personalized, step-by-step learning path with resources from YouTube, official docs, and top-rated courses.",\n      "isEnabled": true\n    },\n    {\n      "name": "Progress Tracker",\n      "description": "Allows users to mark each step as Completed, In Progress, or Skipped, and tracks overall progress.",\n      "isEnabled": true\n    },\n    {\n      "name": "Smart Suggestions",\n      "description": "Evolves recommendations and learning path based on user feedback and progress.",\n      "isEnabled": true\n    },\n    {\n      "name": "Intelligent Content Ranking",\n      "description": "Ranks resources by ratings, length, and suitability for beginners.",\n      "isEnabled": true\n    },\n    {\n      "name": "Multi-format Resources",\n      "description": "Supports text, video, and interactive resources for each learning step.",\n      "isEnabled": true\n    },\n    {\n      "name": "Estimated Time-to-Complete",\n      "description": "Displays estimated time required for each step in the learning path.",\n      "isEnabled": true\n    },\n    {\n      "name": "Weekly Study Plan & Reminders",\n      "description": "(Optional) Generates a weekly study plan and sends email reminders to users.",\n      "isEnabled": false\n    },\n    {\n      "name": "Filters",\n      "description": "Lets users filter resources by difficulty, platform, or available time.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#2D6A4F",\n    "secondary": "#40916C",\n    "accent": "#FFD166"\n  },\n  "theme": "light",\n  "layoutDescription": "The UI features a prominent search bar for entering learning goals at the top. Below, a visual roadmap displays milestones and steps, each with associated resources and progress indicators. Filters and preferences are accessible on the side or as a dropdown. Each step expands to show resource links, estimated time, and completion status. Progress and smart suggestions are shown in a sidebar or as notifications."\n}'}",
